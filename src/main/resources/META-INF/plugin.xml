<idea-plugin>
    <id>io.github.dutu.send2terminal</id>
    <name>Send To Terminal</name>
    <version>2.0.0</version>
    <vendor url="https://github.com/dutu/send2terminal">dutu</vendor>

    <description><![CDATA[
        Send the current line or editor selection directly to the active IDE terminal.
    ]]></description>

    <change-notes><![CDATA[
        <p>Changes are documented in the project changelog.</p>
    ]]></change-notes>

    <idea-version since-build="263"/>

    <depends>com.intellij.modules.lang</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <actions>
        <action id="io.github.dutu.send2terminal.EvalSelection"
                class="io.github.holgerbrandl.send2terminal.actions.EvaluateLineOrSelectionAction"
                text="Evaluate Line/Selection in Terminal"
                description="Evaluate the current line or selection in the terminal">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>